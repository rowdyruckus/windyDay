{
  "expo": {
    "name": "Let's Plant Paradise",
    "slug": "lets-plant-paradise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "letsplantparadise",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.letsplantparadise.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to center the satellite map on your land and estimate your growing zone."
      }
    },
    "android": {
      "package": "com.letsplantparadise.app",
      "adaptiveIcon": {
        "backgroundColor": "#f2a56a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to center the satellite map on your land and estimate your growing zone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0f1a12"
        }
      ]
    ]
  }
}
